{
  "name": "duramax-sac",
  "version": "1.0.0",
  "private": true,
  "description": "Controle de estoque originado de SAC - Duramax",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/local.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && tsc -p client/tsconfig.json && vite build",
    "start": "tsx --env-file-if-exists=.env server/local.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.15"
  }
}